    {
      "name": "https://restful-booker.herokuapp.com/booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Booking ID exists\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.bookingid).to.exist;\r",
              "});\r",
              "\r",
              "pm.test(\"Firstname is Felicienne\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.booking.firstname).to.eql(\"Felicienne\");\r",
              "});\r",
              "\r",
              "pm.test(\"Lastname is Miezan\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.booking.lastname).to.eql(\"Miezan\");\r",
              "});\r",
              "\r",
              "pm.test(\"Response time is less than 2000ms\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
              "});\r",
              "\r",
              "var jsonData = pm.response.json();\r",
              "\r",
              "pm.test(\"Firstname is correct\", function () {\r",
              "    pm.expect(jsonData.booking.firstname).to.eql(\"Marie\");\r",
              "});\r",
              "\r",
              "pm.test(\"Lastname is correct\", function () {\r",
              "    pm.expect(jsonData.booking.lastname).to.eql(\"Miezan\");\r",
              "});\r",
              "\r",
              "pm.test(\"Price is correct\", function () {\r",
              "    pm.expect(jsonData.booking.totalprice).to.eql(150);\r",
              "});\r",
              "\r",
              "pm.test(\"Deposit is true\", function () {\r",
              "    pm.expect(jsonData.booking.depositpaid).to.eql(true);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
